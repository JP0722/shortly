# Copy to .env and adjust. Never commit .env.
SHORTLY_ENV=dev
SHORTLY_HTTP_ADDR=:8080
SHORTLY_BASE_URL=http://localhost:8080

# go-sql-driver/mysql DSN — note this is NOT a URL.
#   parseTime=true  -> DATETIME/TIMESTAMP scan into time.Time instead of []byte
#   loc=UTC         -> store and read times in UTC, never the host's zone
#   collation       -> full utf8mb4 so emoji in URLs don't explode
# Quoted: the DSN contains & ? ( ) which the shell would otherwise interpret
# when you do `set -a && source .env`.
SHORTLY_DATABASE_DSN="shortly:shortly@tcp(localhost:3307)/shortly?parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_0900_ai_ci&timeout=5s"

SHORTLY_REDIS_ADDR=localhost:6383

SHORTLY_LOG_LEVEL=debug
SHORTLY_SHUTDOWN_TIMEOUT=15s
